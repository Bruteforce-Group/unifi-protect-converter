{
  "name": "@ubnt/cv-analytics",
  "version": "1.4.7",
  "description": "AI/CV analytics for node",
  "engines": {
    "node": ">=12.0.0"
  },
  "files": [
    "smart_detect_analytics/**/*.py",
    "src/**/*.js",
    "helper.js",
    "index.js"
  ],
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:tag": "git tag v0.0.0-pr.`git rev-parse --short HEAD`",
    "dev:push": "git push origin v0.0.0-pr.`git rev-parse --short HEAD`",
    "dev:del:local": "git tag -d v0.0.0-pr.`git rev-parse --short HEAD`",
    "dev:del:origin": "git push origin :v0.0.0-pr.`git rev-parse --short HEAD`",
    "_delay": "echo \"Wait on triggering auto build...\" && sleep 10",
    "release:dev": "npm run dev:tag && npm run dev:push && npm run _delay && npm run dev:del:local && npm run dev:del:origin",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubiquiti/node-cv-analytics.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ubiquiti/node-cv-analytics/issues"
  },
  "homepage": "https://github.com/ubiquiti/node-cv-analytics#readme",
  "dependencies": {
    "fs-extra": "^10.1.0",
    "which": "^2.0.2"
  },
  "devDependencies": {
    "auto-changelog": "^2.4.0",
    "release-it": "^14.*"
  }
}
